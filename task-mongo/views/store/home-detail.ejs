<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title></title>

    <link rel="stylesheet" href="/output.css" />
  </head>
  <body>
    <%- include('../partials/nav') %>
    <div>
      <li
        class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden"
      >
        <img
          src="<%= home.homeImage %>"
          alt="<%= home.houseName %>"
          class="w-full h-48 object-cover"
        />
        <div class="p-6">
          <h2 class="text-lg font-semibold text-gray-800 mb-3">
            <%= home.houseName %>
          </h2>
          <div class="space-y-2 text-sm text-gray-600">
            <p>
              <span class="font-medium">Price:</span> <%= home.pricePerNight %>
            </p>
            <p>
              <span class="font-medium">Location:</span> <%= home.location %>
            </p>
            <p><span class="font-medium">Rating:</span> <%= home.rating %></p>
          </div>
          <div class="my-2">
            <a
              href=""
              class="font-medium bg-lime-500 py-1 px-3 rounded-lg hover:bg-slate-400"
              >Book</a
            >
            <a
              href=""
              class="font-medium bg-red-500 py-1 px-3 rounded-lg hover:bg-slate-400"
              >Reserve</a
            >
            <%- include('../partials/form',{home:home.id}) %>
           
          </div>
        </div>
      </li>
    </div>
  </body>
</html>
