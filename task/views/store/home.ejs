  <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="min-h-screen py-8">
      <div class="max-w-7xl mx-auto px-6">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% registeredHomes.forEach((home)=>{ %>
            <li class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow overflow-hidden">
              <img src="<%= home.image %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover">
              <div class="p-6 ">
                <h2 class="text-lg font-semibold text-gray-800 mb-3"><%= home.houseName %></h2>
                <div class="space-y-2 text-sm text-gray-600">
                  <p><span class="font-medium">Price:</span> <%= home.pricePerNight %></p>
                  <p><span class="font-medium">Location:</span> <%= home.location %></p>
                  <p><span class="font-medium">Rating:</span> <%= home.rating %></p>
                </div>
                 <div class="my-2 flex items-center gap-2 flex-wrap-reverse">
                  <a href="" class="font-medium bg-lime-500 py-1 px-3 rounded-lg hover:bg-slate-400">Book</a>
                  <a href="" class="font-medium bg-red-500 py-1 px-3 rounded-lg hover:bg-slate-400">Reserve</a>
                  <a href="" class="font-medium bg-teal-400 py-1 px-3 rounded-lg hover:bg-slate-400">Detail</a>
                  <form action="/favourites/<%= home.id %>?task=add" method="POST" >
                    <button type="submit"class="font-medium bg-teal-400  py-1 px-3  rounded-lg hover:bg-slate-400 " > <%= fav.includes(home.id) ? 'Added' : 'Add To Fav' %></button>
                  </form>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </main>  <footer class="bg-gray-800 text-white text-center py-6 mt-8">Thank You.</footer>
  </body>
</html>
