<!doctype html>
<html lang="en">
  <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="flex items-center justify-center min-h-screen">
      <form action="/login" method="POST" class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
        <h2 class="text-2xl font-bold mb-6 text-gray-800">Enter You Credentials</h2>
        
         <% if(typeof errors != undefined && errors && errors.length > 0) {%>

        <h3>Errors</h3>
        <ul>
          <% errors.map(msg => {%>
          <li type="1"><%= msg %></li>
          <%})%>
        </ul>


      <%} %>
        <input
          type="email"
          name="email"
          value="<%= oldInput.email ? oldInput.email : ''%>"
          placeholder="email"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          required
        />

        <input
          type="password"
          name="password"
          placeholder="Enter your password"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          required
        />

       

        

        

        <input type="submit" value="Sign In" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg cursor-pointer transition-colors" />
      </form>
    </main>
    <footer class="text-center text-gray-600 mt-8">Thank You.</footer>
  </body>
</html>
