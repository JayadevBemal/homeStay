<nav class="w-full h-16 flex justify-between items-center bg-red-500 text-white shadow-md px-6">
  <h1 class="text-2xl font-bold font-mono">Airbnb</h1>

  <% if (!isLoggedIn) { %>
    <div class="d-flex justify-evenly font-mono">
      <a href="/home" class="hover:text-red-800 mx-2">Home</a>
      <a href="/signup" class="hover:text-green-800 mx-2">Sign Up</a>
      <a href="/login" class="hover:text-green-800 mx-2">Login</a>
    </div>
  <% } else if (user && user.userType === 'guest') { %>
    <div class="d-flex justify-evenly font-mono">
      <a href="/home" class="hover:text-red-800 mx-2">Home</a>
      <a href="/favourites" class="hover:text-red-800 mx-2">Favourites</a>
      <a href="/bookings" class="hover:text-red-800 mx-2">Bookings</a>
      <a href="/reserves" class="hover:text-red-800 mx-2">Reserves</a>
      <form action="/logout" method="POST" class="inline">
        <button class="hover:text-green-800 mx-2">Logout</button>
      </form>
    </div>
  <% } else { %>
    <div class="d-flex justify-evenly font-mono">
      <a href="/home" class="hover:text-red-800 mx-2">Home</a>
      <a href="/host/add-home" class="hover:text-red-800 mx-2">AddHome</a>
       <a href="/host/home-list" class="hover:text-red-800 mx-2 " >HostHomes</a>
      <form action="/logout" method="POST" class="inline">
        <button class="hover:text-green-800 mx-2">Logout</button>
      </form>
    </div>
  <% } %>
</nav>
