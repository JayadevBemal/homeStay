<!doctype html>
<html lang="en">
  <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="flex items-center justify-center min-h-screen">
      <form action= <%= editing ? "/host/edit-home" : "/host/add-home" %> method="POST" class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
        <h2 class="text-2xl font-bold mb-6 text-gray-800"><%= editing ? "Edit":"Add" %> Your Home</h2>
        
        <input
          type="text"
          name="houseName"
          value= "<%= editing ? home.houseName : '' %>"
          placeholder="Enter your house name"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          required
        />

        <div class="mb-4">
          <label for="pricePerNight" class="block text-sm font-medium text-gray-700 mb-2">Price per Night</label>
          <input type="number" id="pricePerNight"
          value= "<%= editing ? home.pricePerNight : '' %>"
          placeholder="Enter price" name="pricePerNight" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
        </div>

        <div class="mb-4">
          <label for="location" class="block text-sm font-medium text-gray-700 mb-2">Location</label>
          <input type="text" id="location" 
          value= "<%= editing ? home.location : '' %>"
          placeholder="Enter location" name="location" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-3">Rating</label>
          <div class="space-y-2">
            <% [1,2,3,4,5].map(item =>{%>
              <div class="flex items-center">
              <input type="radio" id="star1" name="rating" value= "<%= item %>" <%= (editing && home.rating == item) ? 'checked' : '' %> class="w-4 h-4"/>
              <label for="star1" class="ml-2 text-gray-700"><%= item %> Star</label>
            </div>
            <%}) %>
          </div>
        </div>
        <% if (editing) {%>
          <div>
          <input type="text" name="_id" value="<%= home._id %>" hidden>
         </div> 
        <%} %>
        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Home Image</label>
        <input type="text" name="homeImage" 
        value= "<%= editing ? home.homeImage : '' %>"
        id="homeImage" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" accept="image/*" required/>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
        <textarea  name="description" 
        value= "<%= editing ? home.description : '' %>"
        id="description" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" accept="image/*" required> <%= editing ? home.description : '' %></textarea>
        </div>

        <input type="submit" value= "<%= editing ? 'Update Home' : 'Add Home' %>" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg cursor-pointer transition-colors" />
      </form>
    </main>
    <footer class="text-center text-gray-600 mt-8">Thank You.</footer>
  </body>
</html>
