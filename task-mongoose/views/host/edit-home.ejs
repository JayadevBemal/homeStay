<!doctype html>
<html lang="en">
  <%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="flex items-center justify-center min-h-screen">
      <form action="/host/add-home" method="POST" class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
        <h2 class="text-2xl font-bold mb-6 text-gray-800">Edit Your Home</h2>
        
        <input
          type="text"
          name="houseName"
          placeholder="Enter your house name"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          required
        />

        <div class="mb-4">
          <label for="pricePerNight" class="block text-sm font-medium text-gray-700 mb-2">Price per Night</label>
          <input type="number" id="pricePerNight" placeholder="Enter price" name="pricePerNight" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
        </div>

        <div class="mb-4">
          <label for="location" class="block text-sm font-medium text-gray-700 mb-2">Location</label>
          <input type="text" id="location" placeholder="Enter location" name="location" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required/>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-3">Rating</label>
          <div class="space-y-2">
        <div class="flex items-center">
          <input type="radio" id="star1" name="rating" value="1" class="w-4 h-4"/>
          <label for="star1" class="ml-2 text-gray-700">1 Star</label>
        </div>
        <div class="flex items-center">
          <input type="radio" id="star2" name="rating" value="2" class="w-4 h-4"/>
          <label for="star2" class="ml-2 text-gray-700">2 Stars</label>
        </div>
        <div class="flex items-center">
          <input type="radio" id="star3" name="rating" value="3" class="w-4 h-4"/>
          <label for="star3" class="ml-2 text-gray-700">3 Stars</label>
        </div>
        <div class="flex items-center">
          <input type="radio" id="star4" name="rating" value="4" class="w-4 h-4"/>
          <label for="star4" class="ml-2 text-gray-700">4 Stars</label>
        </div>
        <div class="flex items-center">
          <input type="radio" id="star5" name="rating" value="5" class="w-4 h-4"/>
       <label for="star5" class="ml-2 text-gray-700">5 Stars</label>
        </div>
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Home Image</label>
        <input type="text" name="homeImage" id="homeImage" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer" accept="image/*" required/>
        </div>

        <input type="submit" value="Add Home" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg cursor-pointer transition-colors" />
      </form>
    </main>
    <footer class="text-center text-gray-600 mt-8">Thank You.</footer>
  </body>
</html>
